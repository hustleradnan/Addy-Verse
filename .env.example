# ===================================================
# Environment Variables Template
# ===================================================
# Ye file sirf REFERENCE ke liye hai.
# Actual values yahan mat likhna — ye public GitHub repo mein dikhti hai.
# Real values Cloudflare Pages ke "Settings > Environment Variables" mein set hongi.
# ===================================================

# Supabase Project URL (public, safe to expose in frontend)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon/Public Key (public, safe to expose in frontend)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (SECRET! Only used in server-side Cloudflare Functions)
# NEVER add "VITE_" prefix to this one, otherwise it will leak into the frontend code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Supabase URL (same as above, but used by server-side functions — no VITE_ prefix)
SUPABASE_URL=https://your-project-id.supabase.co

# Razorpay keys (will be added in Phase 3 — payments)
# RAZORPAY_KEY_ID=
